DATABASE_URL=sqlite:///./research.db
# Optional; a private local key is generated and persisted if this is blank.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
OPENROUTER_API_KEY=
LLM_BACKEND=auto
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_SYNTHESIS_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
EMBEDDING_BACKEND=auto
MAX_UPLOAD_SIZE_MB=50
RETRIEVAL_TOP_K=5
SYNTHESIS_CHUNKS_PER_DOCUMENT=3
SYNTHESIS_CANDIDATE_K=10
SYNTHESIS_MAX_DISTANCE=0.75
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173